# Database (local SQLite by default; switch to PostgreSQL later without code changes)
DATABASE_URL=sqlite:///data/kp_cricket.db

# --- Sportmonks Cricket API (scores / balls) ---
SPORTMONKS_API_KEY=nKWJC98s6VuznEgFYFAyk9xOVffeOzAfyIYzhjNKbfefty3buwXfixAb6Sqc
# Override only if needed (defaults to the v2 cricket API base)
# SPORTMONKS_BASE_URL=https://cricket.sportmonks.com/api/v2.0
# Which data we request per fixture (the includes). Default covers everything
# we need for the chart + live scoring:
# SPORTMONKS_FIXTURE_INCLUDES=localteam,visitorteam,venue,balls,batting,bowling,runs,scoreboards

# --- Odds (optional; cricket odds are plan-gated on Sportmonks) ---
# Turn on to capture odds alongside live score (stored as a time series,
# aligned to the KP timeline). Verify availability first: python -m live.check_api --fixture <id>
CAPTURE_ODDS=0
# Odds live on the separate v3 Odds API:
# SPORTMONKS_ODDS_BASE_URL=https://api.sportmonks.com/v3/cricket
# How we try to obtain odds (first that returns data wins):
# ODDS_STRATEGY=v2_include,v3_inplay,v3_prematch

# --- AI coordinate fallback (used only for grounds missing from the library) ---
# OPENAI_API_KEY=your_openai_key_here
# OPENAI_MODEL=gpt-4o-mini
# ALLOW_AI_COORDS=1

# --- Daemon tuning ---
# POLL_INTERVAL=30
# SCHEDULE_REFRESH=300
# SCHEDULE_DAYS_AHEAD=2

# --- Nightly historical ingest (1:00 AM IST) ---
# Runs in a background thread of run_daemon.py, or standalone:
#   python run_nightly_backfill.py --once
#   python run_nightly_backfill.py --daemon
# NIGHTLY_BACKFILL=1
# NIGHTLY_LOOKBACK_DAYS=3
# NIGHTLY_HOUR=1
# NIGHTLY_CATCHUP=1
